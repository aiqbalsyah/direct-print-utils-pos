#!/bin/sh
set -e

SERVICE=direct-print-server.service

if [ "$1" = "configure" ]; then
    # Older releases installed into /usr/local and /etc/systemd/system.
    # A leftover unit there would override the packaged one.
    if [ -f /etc/systemd/system/$SERVICE ] && ! dpkg -S /etc/systemd/system/$SERVICE >/dev/null 2>&1; then
        rm -f /etc/systemd/system/$SERVICE
    fi

    if command -v restorecon >/dev/null 2>&1; then
        restorecon /usr/bin/direct-print-server 2>/dev/null || true
    fi

    # Only talk to systemd when it is actually running (not in containers/chroots).
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable $SERVICE || true
        if [ -n "$2" ]; then
            systemctl restart $SERVICE || echo "WARNING: could not restart $SERVICE (see: journalctl -u direct-print-server)"
        else
            systemctl start $SERVICE || echo "WARNING: could not start $SERVICE (see: journalctl -u direct-print-server)"
        fi
    fi

    echo ""
    echo "Direct Print Server installed."
    echo "  Web interface : http://localhost:4000"
    echo "  Status        : systemctl status direct-print-server"
    echo "  Logs          : journalctl -u direct-print-server -f"
    if ! lpstat -p >/dev/null 2>&1; then
        echo "  NOTE: no CUPS printer found yet. Add your printer in Settings > Printers"
        echo "        or http://localhost:631, then check with: lpstat -p -d"
    fi
fi

exit 0
