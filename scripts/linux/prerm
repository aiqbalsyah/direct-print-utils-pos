#!/bin/sh
set -e

SERVICE=direct-print-server.service

if [ -d /run/systemd/system ]; then
    case "$1" in
        remove|deconfigure)
            systemctl stop $SERVICE || true
            systemctl disable $SERVICE || true
            ;;
        upgrade)
            # Keep it enabled; postinst of the new version restarts it.
            systemctl stop $SERVICE || true
            ;;
    esac
fi

exit 0
