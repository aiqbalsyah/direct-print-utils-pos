[Unit]
Description=Direct Print Server - Thermal Printer Service
After=network.target cups.service
Wants=cups.service

[Service]
Type=simple
# root is needed for raw USB access to thermal printers via libusb
User=root
ExecStart=/usr/bin/direct-print-server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
