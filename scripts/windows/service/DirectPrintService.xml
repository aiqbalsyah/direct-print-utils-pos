<!-- WinSW config: runs DirectPrintServer.exe as the Windows service "DirectPrintServer".
     Installed/started/removed by the MSI (ServiceInstall/ServiceControl). -->
<service>
  <id>DirectPrintServer</id>
  <name>Direct Print Server</name>
  <description>Thermal printer service for POS (http://localhost:4000)</description>
  <executable>%BASE%\DirectPrintServer.exe</executable>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <stoptimeout>10 sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>5120</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
